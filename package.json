{
  "name": "open-kg",
  "version": "0.1.0",
  "description": "Knowledge Graph compiler - extract structured knowledge from documents using LLMs",
  "type": "module",
  "bin": {
    "kg": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/src/index.js",
    "test": "node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "knowledge-graph",
    "cli",
    "llm",
    "entity-extraction",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
